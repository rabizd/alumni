# Requests for every endpoint, for the VS Code "REST Client" extension
# (humao.rest-client). Click "Send Request" above any request below.
#
# Start the server first:  go run ./cmd/api

@host = http://localhost:8080

### 1. Root - plain OK
GET {{host}}/

### 2. Hello, World!
GET {{host}}/hello

### 3. Greet a name from the path
GET {{host}}/hello/emre

### 3b. Turkish characters survive the round trip
GET {{host}}/hello/çağrı

### 4. Add two numbers
GET {{host}}/sum/7/35

### 4b. Not a number -> 400 Bad Request
GET {{host}}/sum/abc/2

### 5. Temporary redirect (307) to the main page
GET {{host}}/temporary

### 6. About page
GET {{host}}/about

### Main page
GET {{host}}/main

### An unknown path -> 404
GET {{host}}/bilinmeyen


##############################################
# Health check
##############################################

### Is the server up? -> 200 {"status":"ok"}
GET {{host}}/api/health

### Wrong method on the health check -> 405
POST {{host}}/api/health


##############################################
# API documentation
##############################################

### Swagger UI - open this one in a browser, not the REST Client
GET {{host}}/api/swagger

### The OpenAPI document behind it
GET {{host}}/api/swagger.json


##############################################
# Users  (in memory - no database yet)
##############################################

### List every user
GET {{host}}/api/users

### Create a user -> 201 Created, with the id the server assigned
POST {{host}}/api/users
Content-Type: application/json

{
  "name": "Elif Kaya",
  "email": "elif@example.com",
  "department": "Tıp",
  "startYear": 2016,
  "graduationYear": 2022,
  "doubleMajor": "",
  "minor": "Psikoloji",
  "advisor": "Doç. Dr. Şule Arslan",
  "prepExempt": false
}

### Graduation before the start year -> 400
POST {{host}}/api/users
Content-Type: application/json

{
  "name": "Elif Kaya",
  "email": "elif@example.com",
  "department": "Tıp",
  "startYear": 2022,
  "graduationYear": 2016
}

### One user by id
GET {{host}}/api/users/1

### An id that does not exist -> 404
GET {{host}}/api/users/999

### PUT replaces the WHOLE user, so every field is required -> 200
PUT {{host}}/api/users/1
Content-Type: application/json

{
  "name": "Ayse Yilmaz",
  "email": "ayse.yilmaz@example.com",
  "department": "Bilgisayar Mühendisliği",
  "startYear": 2017,
  "graduationYear": 2021,
  "doubleMajor": "Matematik",
  "minor": "",
  "advisor": "Prof. Dr. Ahmet Kaya",
  "prepExempt": true
}

### PATCH changes only what you send; the name stays as it was -> 200
PATCH {{host}}/api/users/1
Content-Type: application/json

{
  "email": "yeni.adres@example.com"
}

### PUT without every field -> 400 (this is what makes PUT different from PATCH)
PUT {{host}}/api/users/1
Content-Type: application/json

{
  "email": "eksik@example.com"
}

### PATCH with nothing to change -> 400
PATCH {{host}}/api/users/1
Content-Type: application/json

{}

### An id that does not exist -> 404
PATCH {{host}}/api/users/999
Content-Type: application/json

{
  "name": "Yok"
}

### An id that is not a number -> 400
PATCH {{host}}/api/users/abc
Content-Type: application/json

{
  "name": "Yok"
}

### Missing email -> 400
POST {{host}}/api/users
Content-Type: application/json

{
  "name": "Sadece isim"
}

### Delete a user -> 204 No Content, with an empty body
DELETE {{host}}/api/users/2

### Deleting the same id again -> 404
DELETE {{host}}/api/users/2

### DELETE needs an id; the collection itself does not accept it -> 405
DELETE {{host}}/api/users


##############################################
# Alumni resource
##############################################

### List every graduate
GET {{host}}/alumni

### Create a graduate -> 201 Created, with the id the server assigned
POST {{host}}/alumni
Content-Type: application/json

{
  "name": "Elif Kaya",
  "department": "Elektrik-Elektronik Mühendisliği",
  "graduationYear": 2023
}

### Missing name -> 400
POST {{host}}/alumni
Content-Type: application/json

{
  "name": "   "
}

### Malformed JSON -> 400
POST {{host}}/alumni
Content-Type: application/json

{ this is not json

### Unknown field -> 400 (a typo in a field name should not be silently ignored)
POST {{host}}/alumni
Content-Type: application/json

{
  "name": "Test",
  "bolum": "Hukuk"
}

### Wrong method on an existing path -> 405 Method Not Allowed
DELETE {{host}}/alumni

### One graduate by id
GET {{host}}/alumni/1

### Replace a graduate -> 200 with the new values
PUT {{host}}/alumni/1
Content-Type: application/json

{
  "name": "Ayşe Yılmaz",
  "department": "Bilgisayar Mühendisliği",
  "graduationYear": 2022
}

### Delete a graduate -> 204 No Content
DELETE {{host}}/alumni/2

### Deleting the same id again -> 404
DELETE {{host}}/alumni/2

### --- /graduates: the HTML side (GraduateController). Easiest in a browser: {{host}}/graduates

### Graduate list page
GET {{host}}/graduates

### Create a graduate from the form -> 303 to /graduates
POST {{host}}/graduates
Content-Type: application/x-www-form-urlencoded

name=Zeynep+Arslan&department=Fizik&graduationYear=2020

### --- /users: the HTML side (UserController). Easiest in a browser: {{host}}/users

### User list page
GET {{host}}/users

### Create from a form -> 303 redirect to /users
POST {{host}}/users
Content-Type: application/x-www-form-urlencoded

name=Zeynep&email=zeynep@example.com&department=Hukuk&startYear=2018&graduationYear=2022&prepExempt=on&minor=İşletme

### Empty name -> 400, the form comes back with the error
POST {{host}}/users
Content-Type: application/x-www-form-urlencoded

name=&email=zeynep@example.com&department=Hukuk&startYear=2018&graduationYear=2022

### Edit form, filled in
GET {{host}}/users/1/edit

### Save the edit form -> 303 redirect to /users/1
POST {{host}}/users/1
Content-Type: application/x-www-form-urlencoded

name=Ayşe Yılmaz&email=ayse.yilmaz@example.com&department=Bilgisayar Mühendisliği&startYear=2017&graduationYear=2021&doubleMajor=Matematik&advisor=Prof. Dr. Ahmet Kaya&prepExempt=on

### Delete -> 303 redirect to /users
POST {{host}}/users/2/delete

##############################################
# Announcements  (in memory - no database yet)
##############################################

### List every announcement, newest first
GET {{host}}/api/announcements

### One announcement
GET {{host}}/api/announcements/1

### Create -> 201, the server sets id and createdAt
POST {{host}}/api/announcements
Content-Type: application/json

{
  "title": "Kütüphane saatleri",
  "body": "Sınav haftası boyunca kütüphane 24 saat açık.",
  "author": "Kütüphane"
}

### Missing body -> 400
POST {{host}}/api/announcements
Content-Type: application/json

{
  "title": "Eksik",
  "author": "Kütüphane"
}

### Replace -> 200, id and createdAt stay the same
PUT {{host}}/api/announcements/1
Content-Type: application/json

{
  "title": "Mezunlar buluşması ertelendi",
  "body": "Buluşma 22 Kasım'a ertelendi.",
  "author": "Mezunlar Ofisi"
}

### Delete -> 204
DELETE {{host}}/api/announcements/2

### --- /announcements: the management interface (AnnouncementController). Easiest in a browser: {{host}}/announcements

### Create from the form -> 303 redirect to /announcements
POST {{host}}/announcements
Content-Type: application/x-www-form-urlencoded

title=Kariyer günü&body=Yarın saat 14:00'te konferans salonunda.&author=Kariyer Merkezi

### Save the edit form -> 303 redirect to /announcements/1
POST {{host}}/announcements/1
Content-Type: application/x-www-form-urlencoded

title=Mezunlar buluşması&body=Yeni tarih: 22 Kasım.&author=Mezunlar Ofisi

### Delete -> 303 redirect to /announcements
POST {{host}}/announcements/1/delete

##############################################
# Job postings
##############################################

### --- Direct routes: a posting by its own id

### List every posting, newest first
GET {{host}}/api/job-postings

### Create -> 201; userId must be an existing user
POST {{host}}/api/job-postings
Content-Type: application/json

{
  "userId": 1,
  "title": "Junior Backend Developer",
  "company": "Acme",
  "location": "İstanbul",
  "employmentType": "full_time",
  "description": "Go ve PostgreSQL bilen, yeni mezun bir arkadaş arıyoruz.",
  "applyUrl": "https://example.com/jobs/1",
  "deadline": "2026-12-31"
}

### A userId that is not a user -> 400 (the foreign key refuses it)
POST {{host}}/api/job-postings
Content-Type: application/json

{
  "userId": 999999,
  "title": "Hayalet ilan",
  "company": "Acme",
  "employmentType": "full_time",
  "description": "Böyle bir kullanıcı yok."
}

### An employmentType outside the list -> 400
POST {{host}}/api/job-postings
Content-Type: application/json

{
  "userId": 1,
  "title": "Serbest iş",
  "company": "Acme",
  "employmentType": "freelance",
  "description": "freelance kabul edilmiyor."
}

### One posting
GET {{host}}/api/job-postings/1

### Replace -> 200; no deadline (null) means open until filled
PUT {{host}}/api/job-postings/1
Content-Type: application/json

{
  "userId": 1,
  "title": "Backend Developer",
  "company": "Acme",
  "location": "Remote",
  "employmentType": "full_time",
  "description": "Pozisyon uzaktan çalışmaya açıldı.",
  "deadline": null
}

### Delete -> 204
DELETE {{host}}/api/job-postings/1

### --- Nested routes: through the user who posted it

### The postings of user 1
GET {{host}}/api/users/1/job-postings

### A user that does not exist -> 404
GET {{host}}/api/users/999999/job-postings

### Create for user 1 -> 201; the user comes from the URL, no userId needed
POST {{host}}/api/users/1/job-postings
Content-Type: application/json

{
  "title": "Yaz stajı",
  "company": "Acme",
  "location": "İstanbul",
  "employmentType": "internship",
  "description": "3. sınıf öğrencileri için 8 haftalık staj.",
  "deadline": "2027-03-01"
}

##############################################
# Applications
##############################################

### --- Direct routes: an application by its own id

### List every application, newest first
GET {{host}}/api/applications

### Apply -> 201; status starts as "pending"
POST {{host}}/api/applications
Content-Type: application/json

{
  "jobPostingId": 1,
  "userId": 2,
  "coverLetter": "Go ile iki yıllık deneyimim var, ilanınız tam bana göre."
}

### The same user applies to the same posting again -> 409 Conflict
POST {{host}}/api/applications
Content-Type: application/json

{
  "jobPostingId": 1,
  "userId": 2
}

### A posting that does not exist -> 400
POST {{host}}/api/applications
Content-Type: application/json

{
  "jobPostingId": 999999,
  "userId": 2
}

### One application
GET {{host}}/api/applications/1

### Accept it -> 200
PUT {{host}}/api/applications/1
Content-Type: application/json

{
  "jobPostingId": 1,
  "userId": 2,
  "coverLetter": "Go ile iki yıllık deneyimim var, ilanınız tam bana göre.",
  "status": "accepted"
}

### A status outside the list -> 400
PUT {{host}}/api/applications/1
Content-Type: application/json

{
  "jobPostingId": 1,
  "userId": 2,
  "status": "maybe"
}

### Withdraw it -> 204
DELETE {{host}}/api/applications/1

### --- Nested routes: through the posting, or through the user

### The applications posting 1 received
GET {{host}}/api/job-postings/1/applications

### Apply to posting 1 -> 201; the posting comes from the URL
POST {{host}}/api/job-postings/1/applications
Content-Type: application/json

{
  "userId": 2,
  "coverLetter": "Staj için başvuruyorum."
}

### A posting that does not exist -> 404
GET {{host}}/api/job-postings/999999/applications

### The applications user 2 made
GET {{host}}/api/users/2/applications
