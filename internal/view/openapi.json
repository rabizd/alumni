          "body": { "type": "string", "example": "Bu yılki mezunlar buluşması 15 Kasım'da Beyazıt kampüsünde." },
          "author": { "type": "string", "example": "Mezunlar Ofisi" },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true, "example": "2026-10-01T10:00:00+03:00" }
        }
      },
      "NewAnnouncement": {
        "type": "object",
        "required": ["title", "body", "author"],
        "properties": {
          "title": { "type": "string", "example": "Kütüphane saatleri" },
          "body": { "type": "string", "example": "Sınav haftası boyunca kütüphane 24 saat açık." },
          "author": { "type": "string", "example": "Kütüphane" }
        }
      },
      "JobPosting": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true, "example": 1 },
          "userId": { "type": "integer", "example": 1, "description": "İlanı açan kullanıcı" },
          "title": { "type": "string", "example": "Junior Backend Developer" },
          "company": { "type": "string", "example": "Acme" },
          "location": { "type": "string", "example": "İstanbul", "description": "Şehir ya da Remote; yoksa boş" },
          "employmentType": { "type": "string", "enum": ["full_time", "part_time", "internship"], "example": "full_time" },
          "description": { "type": "string", "example": "Go ve PostgreSQL bilen, yeni mezun bir arkadaş arıyoruz." },
          "applyUrl": { "type": "string", "example": "https://example.com/jobs/1", "description": "Başvuru linki; yoksa boş (ilanı açana ulaşılır)" },
          "deadline": { "type": "string", "format": "date", "nullable": true, "example": "2026-12-31", "description": "Son başvuru günü; null: dolana kadar açık" },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true, "example": "2026-10-21T10:00:00+03:00" }
        }
      },
      "NewJobPosting": {
        "type": "object",
        "required": ["userId", "title", "company", "employmentType", "description"],
        "properties": {
          "userId": { "type": "integer", "example": 1, "description": "Var olan bir kullanıcı. Nested route'ta gerekmez, URL'deki id kullanılır." },
          "title": { "type": "string", "example": "Junior Backend Developer" },
          "company": { "type": "string", "example": "Acme" },
          "location": { "type": "string", "example": "İstanbul" },
          "employmentType": { "type": "string", "enum": ["full_time", "part_time", "internship"], "example": "full_time" },
          "description": { "type": "string", "example": "Go ve PostgreSQL bilen, yeni mezun bir arkadaş arıyoruz." },
          "applyUrl": { "type": "string", "example": "https://example.com/jobs/1" },
          "deadline": { "type": "string", "format": "date", "nullable": true, "example": "2026-12-31", "description": "Bugünden önce olamaz" }
        }
      },
      "Alumni": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true, "example": 1 },
          "name": { "type": "string", "example": "Ayşe Yılmaz" },
          "department": { "type": "string", "example": "Bilgisayar Mühendisliği" },
          "graduationYear": { "type": "integer", "example": 2021, "description": "0: belirtilmemiş" }
        }
      },
      "NewAlumni": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "Elif Kaya" },
          "department": { "type": "string", "example": "Fizik" },
          "graduationYear": { "type": "integer", "example": 2023 }
        }
      }
    },
    "responses": {
      "AnnouncementNotFound": {
        "description": "Bu id'ye sahip duyuru yok",
        "content": {
          "text/plain": { "schema": { "type": "string" }, "example": "no announcement with that id" }
        }
      },
      "JobPostingNotFound": {
        "description": "Bu id'ye sahip ilan yok",
        "content": {
          "text/plain": { "schema": { "type": "string" }, "example": "no job posting with that id" }
        }
      },
      "BadRequest": {
        "description": "İstek hatalı: bozuk JSON, eksik alan, kurala uymayan yıl ya da sayı olmayan id",
        "content": {
          "text/plain": { "schema": { "type": "string" }, "example": "name is required" }
        }
      },
      "HtmlPage": {
        "description": "HTML sayfası",
        "content": { "text/html": { "schema": { "type": "string" } } }
      },
      "RedirectToList": {
        "description": "Tamam; tarayıcı kullanıcı listesine (/users) gönderilir",
        "headers": { "Location": { "schema": { "type": "string", "example": "/users" } } }
      },
      "FormWithError": {
        "description": "Eksik alan: form, hata mesajı ve girilen değerlerle yeniden gösterilir",
        "content": { "text/html": { "schema": { "type": "string" } } }
      },
      "NotFound": {
        "description": "Bu id'ye sahip kullanıcı yok",
        "content": {
          "text/plain": { "schema": { "type": "string" }, "example": "no user with that id" }
        }
      },
      "GraduateNotFound": {
        "description": "Bu id'ye sahip mezun yok",
        "content": {
          "text/plain": { "schema": { "type": "string" }, "example": "no graduate with that id" }
        }
      }
    }
  }
}
