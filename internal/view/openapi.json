{
  "openapi": "3.0.3",
  "info": {
    "title": "Alumni API",
    "description": "İstanbul Üniversitesi mezun ağı. Kullanıcılar, duyurular, iş ilanları ve mezunlar PostgreSQL'de tutulur; sunucu yeniden başlasa da kaybolmaz.",
    "version": "0.1.0"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Yerel geliştirme" }
  ],
  "tags": [
    { "name": "health", "description": "Sunucu ayakta mı?" },
    { "name": "ApiUserController", "description": "Kullanıcılar, JSON olarak (/api/users) — programlar için." },
    { "name": "UserController", "description": "Kullanıcılar, HTML sayfası olarak (/users) — tarayıcıdaki insanlar için. Formlar yalnızca GET ve POST gönderebildiğinden güncelleme ve silme burada POST'tur. Başarılı bir POST 303 ile yönlendirir; Swagger yönlendirmeyi takip edip varılan sayfayı gösterir." },
    { "name": "ApiAnnouncementController", "description": "Duyurular, JSON olarak (/api/announcements) — programlar için. En yeni duyuru en üstte." },
    { "name": "ApiJobPostingController", "description": "İş ve staj ilanları, JSON olarak. Doğrudan: /api/job-postings/{id}. İç içe (nested), ilanı açan kullanıcı üzerinden: /api/users/{id}/job-postings. En yeni ilan en üstte." },
    { "name": "AnnouncementController", "description": "Duyuruları yönetme arayüzü, HTML sayfası olarak (/announcements). Güncelleme ve silme POST'tur; başarılı bir POST 303 ile yönlendirir." },
    { "name": "Alumni", "description": "Mezunlar, JSON olarak (/alumni) — programlar için." },
    { "name": "GraduateController", "description": "Mezunları yönetme arayüzü, HTML sayfası olarak (/graduates). Güncelleme ve silme POST'tur; başarılı bir POST 303 ile yönlendirir." }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["health"],
        "operationId": "Health",
        "summary": "Sağlık kontrolü",
        "description": "Bu uç noktaya ulaşabilmek zaten kontrolün kendisidir: süreç ayakta ve yönlendirme doğru kurulmuş demektir.",
        "responses": {
          "200": {
            "description": "Sunucu ayakta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Index",
        "summary": "Bütün kullanıcıları listele",
        "responses": {
          "200": {
            "description": "Kullanıcı dizisi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Store",
        "summary": "Yeni kullanıcı oluştur",
        "description": "id alanını sunucu verir; gövdede göndermeye çalışma.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewUser" },
              "example": { "name": "Elif Kaya", "email": "elif@example.com", "department": "Tıp", "startYear": 2016, "graduationYear": 2022, "doubleMajor": "", "minor": "Psikoloji", "advisor": "Doç. Dr. Şule Arslan", "prepExempt": false }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oluşturuldu",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Kullanıcının id'si",
          "schema": { "type": "integer", "example": 1 }
        }
      ],
      "get": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Show",
        "summary": "Tek bir kullanıcıyı getir",
        "responses": {
          "200": {
            "description": "Kullanıcı bulundu",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Update",
        "summary": "Kullanıcıyı bütünüyle değiştir",
        "description": "PUT kaydın yeni hâlinin tamamıdır, bu yüzden her alan zorunludur. Eksik alan gönderirsen 400 alırsın. Yalnızca bir alanı değiştirmek istiyorsan PATCH kullan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewUser" },
              "example": { "name": "Ayşe Yıldız", "email": "ayse.yildiz@example.com", "department": "Bilgisayar Mühendisliği", "startYear": 2017, "graduationYear": 2021, "doubleMajor": "Matematik", "minor": "", "advisor": "Prof. Dr. Ahmet Kaya", "prepExempt": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Değiştirildi",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Patch",
        "summary": "Kullanıcının yalnızca gönderilen alanlarını değiştir",
        "description": "Gövdede anmadığın alanlar olduğu gibi kalır. En az bir alan göndermelisin.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPatch" },
              "example": { "graduationYear": 2022, "prepExempt": false }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Güncellendi",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Destroy",
        "summary": "Kullanıcıyı sil",
        "responses": {
          "204": { "description": "Silindi; geri gönderilecek gövde yok" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["UserController"],
        "operationId": "UserController.Index",
        "summary": "Kullanıcı listesi sayfası",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" }
        }
      },
      "post": {
        "tags": ["UserController"],
        "operationId": "UserController.Store",
        "summary": "Formdan yeni kullanıcı oluştur",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/NewUser" }
            }
          }
        },
        "responses": {
          "303": { "$ref": "#/components/responses/RedirectToList" },
          "400": { "$ref": "#/components/responses/FormWithError" }
        }
      }
    },
    "/users/new": {
      "get": {
        "tags": ["UserController"],
        "operationId": "UserController.Create",
        "summary": "Boş \"yeni kullanıcı\" formu",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" }
        }
      }
    },
    "/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/UserID" }],
      "get": {
        "tags": ["UserController"],
        "operationId": "UserController.Show",
        "summary": "Tek bir kullanıcının sayfası",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["UserController"],
        "operationId": "UserController.Update",
        "summary": "Düzenleme formunu kaydet",
        "description": "Her alan zorunludur, API'deki PUT gibi.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/NewUser" }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Kaydedildi; tarayıcı kullanıcının sayfasına (/users/{id}) gönderilir",
            "headers": { "Location": { "schema": { "type": "string", "example": "/users/1" } } }
          },
          "400": { "$ref": "#/components/responses/FormWithError" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users/{id}/edit": {
      "parameters": [{ "$ref": "#/components/parameters/UserID" }],
      "get": {
        "tags": ["UserController"],
        "operationId": "UserController.Edit",
        "summary": "Mevcut değerlerle doldurulmuş düzenleme formu",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users/{id}/delete": {
      "parameters": [{ "$ref": "#/components/parameters/UserID" }],
      "post": {
        "tags": ["UserController"],
        "operationId": "UserController.Destroy",
        "summary": "Kullanıcıyı sil",
        "responses": {
          "303": { "$ref": "#/components/responses/RedirectToList" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/announcements": {
      "get": {
        "tags": ["ApiAnnouncementController"],
        "operationId": "ApiAnnouncementController.Index",
        "summary": "Bütün duyuruları listele (en yeni en üstte)",
        "responses": {
          "200": {
            "description": "Duyuru dizisi",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Announcement" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["ApiAnnouncementController"],
        "operationId": "ApiAnnouncementController.Store",
        "summary": "Yeni duyuru oluştur",
        "description": "id ve createdAt alanlarını sunucu verir; gövdede gönderilirse yok sayılır.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewAnnouncement" },
              "example": { "title": "Kütüphane saatleri", "body": "Sınav haftası boyunca kütüphane 24 saat açık.", "author": "Kütüphane" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oluşturuldu",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Announcement" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/announcements/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/AnnouncementID" }],
      "get": {
        "tags": ["ApiAnnouncementController"],
        "operationId": "ApiAnnouncementController.Show",
        "summary": "Tek bir duyuruyu getir",
        "responses": {
          "200": {
            "description": "Duyuru bulundu",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Announcement" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/AnnouncementNotFound" }
        }
      },
      "put": {
        "tags": ["ApiAnnouncementController"],
        "operationId": "ApiAnnouncementController.Update",
        "summary": "Duyuruyu bütünüyle değiştir",
        "description": "Başlık, metin ve yapan kişi zorunludur. id ve createdAt değişmez.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewAnnouncement" },
              "example": { "title": "Mezunlar buluşması ertelendi", "body": "Buluşma 22 Kasım'a ertelendi.", "author": "Mezunlar Ofisi" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Değiştirildi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Announcement" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/AnnouncementNotFound" }
        }
      },
      "delete": {
        "tags": ["ApiAnnouncementController"],
        "operationId": "ApiAnnouncementController.Destroy",
        "summary": "Duyuruyu sil",
        "responses": {
          "204": { "description": "Silindi; geri gönderilecek gövde yok" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/AnnouncementNotFound" }
        }
      }
    },
    "/api/job-postings": {
      "get": {
        "tags": ["ApiJobPostingController"],
        "operationId": "ApiJobPostingController.Index",
        "summary": "Bütün ilanları listele (en yeni en üstte)",
        "responses": {
          "200": {
            "description": "İlan dizisi",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/JobPosting" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["ApiJobPostingController"],
        "operationId": "ApiJobPostingController.Store",
        "summary": "Yeni ilan oluştur (kullanıcı gövdedeki userId)",
        "description": "id ve createdAt alanlarını sunucu verir. userId var olan bir kullanıcı olmalı, yoksa 400.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewJobPosting" },
              "example": { "userId": 1, "title": "Junior Backend Developer", "company": "Acme", "location": "İstanbul", "employmentType": "full_time", "description": "Go ve PostgreSQL bilen, yeni mezun bir arkadaş arıyoruz.", "applyUrl": "https://example.com/jobs/1", "deadline": "2026-12-31" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oluşturuldu",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobPosting" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/job-postings/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/JobPostingID" }],
      "get": {
        "tags": ["ApiJobPostingController"],
        "operationId": "ApiJobPostingController.Show",
        "summary": "Tek bir ilanı getir",
        "responses": {
          "200": {
            "description": "İlan bulundu",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobPosting" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/JobPostingNotFound" }
        }
      },
      "put": {
        "tags": ["ApiJobPostingController"],
        "operationId": "ApiJobPostingController.Update",
        "summary": "İlanı bütünüyle değiştir",
        "description": "Zorunlu alanların hepsi gönderilmeli. id ve createdAt değişmez.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewJobPosting" },
              "example": { "userId": 1, "title": "Backend Developer", "company": "Acme", "location": "Remote", "employmentType": "full_time", "description": "Pozisyon uzaktan çalışmaya açıldı.", "applyUrl": "", "deadline": null }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Değiştirildi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobPosting" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/JobPostingNotFound" }
        }
      },
      "delete": {
        "tags": ["ApiJobPostingController"],
        "operationId": "ApiJobPostingController.Destroy",
        "summary": "İlanı sil",
        "responses": {
          "204": { "description": "Silindi; geri gönderilecek gövde yok" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/JobPostingNotFound" }
        }
      }
    },
    "/api/users/{id}/job-postings": {
      "parameters": [{ "$ref": "#/components/parameters/UserID" }],
      "get": {
        "tags": ["ApiJobPostingController"],
        "operationId": "ApiJobPostingController.UserIndex",
        "summary": "Bir kullanıcının ilanları (nested)",
        "responses": {
          "200": {
            "description": "Kullanıcının ilanları; hiç yoksa boş dizi",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/JobPosting" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["ApiJobPostingController"],
        "operationId": "ApiJobPostingController.UserStore",
        "summary": "Bu kullanıcı adına ilan oluştur (nested)",
        "description": "Kullanıcı URL'deki id'dir; gövdede userId gönderilirse onun yerine URL'deki geçer.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewJobPosting" },
              "example": { "title": "Yaz stajı", "company": "Acme", "location": "İstanbul", "employmentType": "internship", "description": "3. sınıf öğrencileri için 8 haftalık staj.", "deadline": "2027-03-01" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oluşturuldu",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobPosting" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/announcements": {
      "get": {
        "tags": ["AnnouncementController"],
        "operationId": "AnnouncementController.Index",
        "summary": "Duyuru listesi ve altında yeni duyuru formu",
        "responses": { "200": { "$ref": "#/components/responses/HtmlPage" } }
      },
      "post": {
        "tags": ["AnnouncementController"],
        "operationId": "AnnouncementController.Store",
        "summary": "Formdan yeni duyuru oluştur",
        "requestBody": {
          "required": true,
          "content": { "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/NewAnnouncement" } } }
        },
        "responses": {
          "303": {
            "description": "Tamam; tarayıcı duyuru listesine (/announcements) gönderilir",
            "headers": { "Location": { "schema": { "type": "string", "example": "/announcements" } } }
          },
          "400": { "$ref": "#/components/responses/FormWithError" }
        }
      }
    },
    "/announcements/new": {
      "get": {
        "tags": ["AnnouncementController"],
        "operationId": "AnnouncementController.Create",
        "summary": "Boş \"yeni duyuru\" formu",
        "responses": { "200": { "$ref": "#/components/responses/HtmlPage" } }
      }
    },
    "/announcements/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/AnnouncementID" }],
      "get": {
        "tags": ["AnnouncementController"],
        "operationId": "AnnouncementController.Show",
        "summary": "Tek bir duyurunun sayfası",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/AnnouncementNotFound" }
        }
      },
      "post": {
        "tags": ["AnnouncementController"],
        "operationId": "AnnouncementController.Update",
        "summary": "Düzenleme formunu kaydet",
        "requestBody": {
          "required": true,
          "content": { "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/NewAnnouncement" } } }
        },
        "responses": {
          "303": {
            "description": "Kaydedildi; tarayıcı duyurunun sayfasına (/announcements/{id}) gönderilir",
            "headers": { "Location": { "schema": { "type": "string", "example": "/announcements/1" } } }
          },
          "400": { "$ref": "#/components/responses/FormWithError" },
          "404": { "$ref": "#/components/responses/AnnouncementNotFound" }
        }
      }
    },
    "/announcements/{id}/edit": {
      "parameters": [{ "$ref": "#/components/parameters/AnnouncementID" }],
      "get": {
        "tags": ["AnnouncementController"],
        "operationId": "AnnouncementController.Edit",
        "summary": "Mevcut değerlerle doldurulmuş düzenleme formu",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/AnnouncementNotFound" }
        }
      }
    },
    "/announcements/{id}/delete": {
      "parameters": [{ "$ref": "#/components/parameters/AnnouncementID" }],
      "post": {
        "tags": ["AnnouncementController"],
        "operationId": "AnnouncementController.Destroy",
        "summary": "Duyuruyu sil",
        "responses": {
          "303": {
            "description": "Silindi; tarayıcı duyuru listesine (/announcements) gönderilir",
            "headers": { "Location": { "schema": { "type": "string", "example": "/announcements" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/AnnouncementNotFound" }
        }
      }
    },
    "/alumni": {
      "get": {
        "tags": ["Alumni"],
        "operationId": "ListAlumni",
        "summary": "Tüm mezunları listele",
        "responses": {
          "200": {
            "description": "Mezunlar, id sırasıyla",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Alumni" } } } }
          }
        }
      },
