{
  "openapi": "3.0.3",
  "info": {
    "title": "Alumni API",
    "description": "İstanbul Üniversitesi mezun ağı. Kullanıcılar şimdilik bellekte tutuluyor, veritabanı henüz yok: sunucu yeniden başlayınca her şey sıfırlanır.",
    "version": "0.1.0"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Yerel geliştirme" }
  ],
  "tags": [
    { "name": "health", "description": "Sunucu ayakta mı?" },
    { "name": "ApiUserController", "description": "Kullanıcılar, JSON olarak (/api/users) — programlar için. Bellekte tutulur." },
    { "name": "UserController", "description": "Kullanıcılar, HTML sayfası olarak (/users) — tarayıcıdaki insanlar için. Formlar yalnızca GET ve POST gönderebildiğinden güncelleme ve silme burada POST'tur. Başarılı bir POST 303 ile yönlendirir; Swagger yönlendirmeyi takip edip varılan sayfayı gösterir." }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["health"],
        "operationId": "Health",
        "summary": "Sağlık kontrolü",
        "description": "Bu uç noktaya ulaşabilmek zaten kontrolün kendisidir: süreç ayakta ve yönlendirme doğru kurulmuş demektir.",
        "responses": {
          "200": {
            "description": "Sunucu ayakta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Index",
        "summary": "Bütün kullanıcıları listele",
        "responses": {
          "200": {
            "description": "Kullanıcı dizisi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Store",
        "summary": "Yeni kullanıcı oluştur",
        "description": "id alanını sunucu verir; gövdede göndermeye çalışma.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewUser" },
              "example": { "name": "Elif Kaya", "email": "elif@example.com" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oluşturuldu",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Kullanıcının id'si",
          "schema": { "type": "integer", "example": 1 }
        }
      ],
      "get": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Show",
        "summary": "Tek bir kullanıcıyı getir",
        "responses": {
          "200": {
            "description": "Kullanıcı bulundu",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Update",
        "summary": "Kullanıcıyı bütünüyle değiştir",
        "description": "PUT kaydın yeni hâlinin tamamıdır, bu yüzden her alan zorunludur. Eksik alan gönderirsen 400 alırsın. Yalnızca bir alanı değiştirmek istiyorsan PATCH kullan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewUser" },
              "example": { "name": "Ayşe Yıldız", "email": "ayse.yildiz@example.com" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Değiştirildi",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Patch",
        "summary": "Kullanıcının yalnızca gönderilen alanlarını değiştir",
        "description": "Gövdede anmadığın alanlar olduğu gibi kalır. En az bir alan göndermelisin.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPatch" },
              "example": { "email": "yeni@example.com" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Güncellendi",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["ApiUserController"],
        "operationId": "ApiUserController.Destroy",
        "summary": "Kullanıcıyı sil",
        "responses": {
          "204": { "description": "Silindi; geri gönderilecek gövde yok" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["UserController"],
        "operationId": "UserController.Index",
        "summary": "Kullanıcı listesi sayfası",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" }
        }
      },
      "post": {
        "tags": ["UserController"],
        "operationId": "UserController.Store",
        "summary": "Formdan yeni kullanıcı oluştur",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/NewUser" }
            }
          }
        },
        "responses": {
          "303": { "$ref": "#/components/responses/RedirectToList" },
          "400": { "$ref": "#/components/responses/FormWithError" }
        }
      }
    },
    "/users/new": {
      "get": {
        "tags": ["UserController"],
        "operationId": "UserController.Create",
        "summary": "Boş \"yeni kullanıcı\" formu",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" }
        }
      }
    },
    "/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/UserID" }],
      "get": {
        "tags": ["UserController"],
        "operationId": "UserController.Show",
        "summary": "Tek bir kullanıcının sayfası",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["UserController"],
        "operationId": "UserController.Update",
        "summary": "Düzenleme formunu kaydet",
        "description": "Her alan zorunludur, API'deki PUT gibi.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/NewUser" }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Kaydedildi; tarayıcı kullanıcının sayfasına (/users/{id}) gönderilir",
            "headers": { "Location": { "schema": { "type": "string", "example": "/users/1" } } }
          },
          "400": { "$ref": "#/components/responses/FormWithError" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users/{id}/edit": {
      "parameters": [{ "$ref": "#/components/parameters/UserID" }],
      "get": {
        "tags": ["UserController"],
        "operationId": "UserController.Edit",
        "summary": "Mevcut değerlerle doldurulmuş düzenleme formu",
        "responses": {
          "200": { "$ref": "#/components/responses/HtmlPage" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users/{id}/delete": {
      "parameters": [{ "$ref": "#/components/parameters/UserID" }],
      "post": {
        "tags": ["UserController"],
        "operationId": "UserController.Destroy",
        "summary": "Kullanıcıyı sil",
        "responses": {
          "303": { "$ref": "#/components/responses/RedirectToList" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "UserID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Kullanıcının id'si",
        "schema": { "type": "integer", "example": 1 }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true, "example": 1 },
          "name": { "type": "string", "example": "Ayşe Yılmaz" },
          "email": { "type": "string", "example": "ayse@example.com" }
        }
      },
      "NewUser": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": { "type": "string", "example": "Elif Kaya" },
          "email": { "type": "string", "example": "elif@example.com" }
        }
      },
      "UserPatch": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "example": "Elif Kaya" },
          "email": { "type": "string", "example": "yeni@example.com" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "İstek hatalı: bozuk JSON, eksik alan ya da sayı olmayan id",
        "content": {
          "text/plain": { "schema": { "type": "string" }, "example": "name is required" }
        }
      },
      "HtmlPage": {
        "description": "HTML sayfası",
        "content": { "text/html": { "schema": { "type": "string" } } }
      },
      "RedirectToList": {
        "description": "Tamam; tarayıcı kullanıcı listesine (/users) gönderilir",
        "headers": { "Location": { "schema": { "type": "string", "example": "/users" } } }
      },
      "FormWithError": {
        "description": "Eksik alan: form, hata mesajı ve girilen değerlerle yeniden gösterilir",
        "content": { "text/html": { "schema": { "type": "string" } } }
      },
      "NotFound": {
        "description": "Bu id'ye sahip kullanıcı yok",
        "content": {
          "text/plain": { "schema": { "type": "string" }, "example": "no user with that id" }
        }
      }
    }
  }
}
