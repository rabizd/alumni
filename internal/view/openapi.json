  "components": {
    "parameters": {
      "AnnouncementID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Duyurunun id'si",
        "schema": { "type": "integer", "example": 1 }
      },
      "JobPostingID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "İlanın id'si",
        "schema": { "type": "integer", "example": 1 }
      },
      "UserID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Kullanıcının id'si",
        "schema": { "type": "integer", "example": 1 }
      },
      "GraduateID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Mezunun id'si",
        "schema": { "type": "integer", "example": 1 }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true, "example": 1 },
          "name": { "type": "string", "example": "Ayşe Yılmaz" },
          "email": { "type": "string", "example": "ayse@example.com" },
          "department": { "type": "string", "example": "Bilgisayar Mühendisliği" },
          "startYear": { "type": "integer", "minimum": 1900, "example": 2017, "description": "Başlangıç yılı; 1900 ile bu yıl arasında" },
          "graduationYear": { "type": "integer", "example": 2021, "description": "Mezuniyet yılı; başlangıç yılından önce ve gelecekte olamaz" },
          "doubleMajor": { "type": "string", "example": "Matematik", "description": "ÇAP bölümü; yoksa boş" },
          "minor": { "type": "string", "example": "", "description": "Yandal bölümü; yoksa boş" },
          "advisor": { "type": "string", "example": "Prof. Dr. Ahmet Kaya", "description": "Danışman; yoksa boş" },
          "prepExempt": { "type": "boolean", "example": true, "description": "İngilizce hazırlıktan muaf mı?" }
        }
      },
      "NewUser": {
        "type": "object",
        "required": ["name", "email", "department", "startYear", "graduationYear"],
        "properties": {
          "name": { "type": "string", "example": "Elif Kaya" },
          "email": { "type": "string", "example": "elif@example.com" },
          "department": { "type": "string", "example": "Bilgisayar Mühendisliği" },
          "startYear": { "type": "integer", "minimum": 1900, "example": 2017, "description": "Başlangıç yılı; 1900 ile bu yıl arasında" },
          "graduationYear": { "type": "integer", "example": 2021, "description": "Mezuniyet yılı; başlangıç yılından önce ve gelecekte olamaz" },
          "doubleMajor": { "type": "string", "example": "Matematik", "description": "ÇAP bölümü; yoksa boş" },
          "minor": { "type": "string", "example": "", "description": "Yandal bölümü; yoksa boş" },
          "advisor": { "type": "string", "example": "Prof. Dr. Ahmet Kaya", "description": "Danışman; yoksa boş" },
          "prepExempt": { "type": "boolean", "example": true, "description": "İngilizce hazırlıktan muaf mı?" }
        }
      },
      "UserPatch": {
        "type": "object",
        "minProperties": 1,
        "description": "Gönderilen alanlar değişir. Sonuç yine bütün kurallara uymalı; örneğin mezuniyet yılı başlangıç yılından önce olamaz.",
        "properties": {
          "name": { "type": "string", "example": "Elif Kaya" },
          "email": { "type": "string", "example": "yeni@example.com" },
          "department": { "type": "string", "example": "Bilgisayar Mühendisliği" },
          "startYear": { "type": "integer", "minimum": 1900, "example": 2017, "description": "Başlangıç yılı; 1900 ile bu yıl arasında" },
          "graduationYear": { "type": "integer", "example": 2021, "description": "Mezuniyet yılı; başlangıç yılından önce ve gelecekte olamaz" },
          "doubleMajor": { "type": "string", "example": "Matematik", "description": "ÇAP bölümü; yoksa boş" },
          "minor": { "type": "string", "example": "", "description": "Yandal bölümü; yoksa boş" },
          "advisor": { "type": "string", "example": "Prof. Dr. Ahmet Kaya", "description": "Danışman; yoksa boş" },
          "prepExempt": { "type": "boolean", "example": true, "description": "İngilizce hazırlıktan muaf mı?" }
