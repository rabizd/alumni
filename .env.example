# Copy this file to .env and change the values if you need to:
#   cp .env.example .env
# .env is in .gitignore, so your own values are never committed.
# Docker Compose reads .env automatically when you run `docker compose up`.

# Port the app listens on, inside the container and on your machine
APP_PORT=8080

# PostgreSQL user and database name
DB_USER=alumni
DB_NAME=alumni

# Port PostgreSQL is reachable on from your machine
DB_PORT=5432

# Port of Adminer, the database viewer in the browser (http://localhost:8081)
ADMINER_PORT=8081

# The database password is NOT set here. It is a Docker Compose secret:
# put it in secrets/db_password.txt (also not committed).
